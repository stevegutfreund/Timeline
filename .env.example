# timeline settings. Copy to .env; .env is git-ignored.
NODE_ENV=production
HOST=127.0.0.1
PORT=5002

# Token the UI sends with write requests. Leave empty to get a random one per run.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_TOKEN=

# Data (git-ignored). Relative paths are resolved against this folder.
DATA_FILE=events.json
BACKUP_DIR=backups
